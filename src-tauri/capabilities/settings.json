  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:window:default",
    "dialog:default",
    "autostart:default",
    "store:default"
  ]
}
